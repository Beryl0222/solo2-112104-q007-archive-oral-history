[
  {
    "id": "oral-1",
    "interview": "I-7",
    "version": 1,
    "text": "我舅舅阿成带我去旧桥边，那时河还没改道。"
  },
  {
    "id": "oral-2",
    "interview": "I-7",
    "version": 2,
    "text": "复听更正：这里说的是表舅陈成，不是本村的阿成。"
  },
  {
    "id": "oral-3",
    "interview": "I-8",
    "version": 1,
    "text": "听老人讲，旧桥在改道前就拆了；我没有亲眼见过。"
  },
  {
    "id": "oral-4",
    "interview": "I-8",
    "version": 1,
    "text": "展陈稿引用 I-8 作为亲历证言，尚未完成档案复核。"
  }
]
